# Sigma Rule Repository Path (host machine)
# This is the path on YOUR machine where the Sigma rules are located
# Used by Docker to mount the rules directory into the container
SIGMA_RULES_HOST_PATH=/path/to/sigma

# Sigma Rule Repository Path (inside container)
# This is set automatically in docker-compose.yml, no need to change
# SIGMA_REPO_PATH=/sigma-rules

# Streamlit Configuration (optional)
# Uncomment to override defaults
# STREAMLIT_SERVER_PORT=8501
# STREAMLIT_SERVER_ADDRESS=localhost
# STREAMLIT_SERVER_HEADLESS=true
